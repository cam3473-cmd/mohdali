// نظام إدارة بيانات المستفيدين والدعوم - جمعية البر الخيرية بمحافظة السليل
// ملاحظة: SQLite لا يدعم الأنواع Enum في Prisma، لذا تُستخدم حقول نصية (String)
// والتحقق من القيم المسموح بها يتم عبر Zod في طبقة الـ API (server/src/routes).
// القيم المسموح بها لكل حقل موثّقة بجانب الحقل أدناه.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// المستخدمون (موظفو الجمعية)
model User {
  id           String   @id @default(cuid())
  username     String   @unique
  fullName     String
  passwordHash String
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  createdBeneficiaries Beneficiary[]       @relation("BeneficiaryCreatedBy")
  supports             Support[]           @relation("SupportCreatedBy")
  batches              SupportBatch[]      @relation("BatchCreatedBy")
  courses              Course[]            @relation("CourseCreatedBy")
  participants         CourseParticipant[] @relation("ParticipantCreatedBy")
}

// المستفيدون
model Beneficiary {
  id                 String    @id @default(cuid())
  fileNumber         String?   @unique // رقم الملف الداخلي (مرجع الجمعية)
  nationalId         String    @unique // رقم الهوية الوطنية
  fullName           String
  gender             String // MALE | FEMALE
  birthDate          DateTime?
  birthDateHijri     String? // تاريخ الميلاد الهجري (نص، بدون تحويل تلقائي)
  maritalStatus      String? // SINGLE | MARRIED | DIVORCED | WIDOWED
  caseType           String? // نوع الملف: INDIVIDUAL (فرد) | FAMILY (أسرة)
  familyMembersCount Int? // عدد أفراد الأسرة
  monthlyIncome      Float? // الدخل الشهري
  neighborhood       String? // الحي / الموقع
  address            String?
  phone              String?
  iban               String? // رقم الآيبان البنكي (للتحويل النقدي)
  needCategory       String? // تصنيف الاحتياج (احتياج مادي، تأهيلي، ...)
  fileStatus         String    @default("ACTIVE") // ACTIVE | SUSPENDED | CLOSED
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  createdById        String?
  createdBy          User?     @relation("BeneficiaryCreatedBy", fields: [createdById], references: [id])

  supports     Support[]
  participants CourseParticipant[]

  @@index([fullName])
  @@index([fileStatus])
}

// الدعم (نموذج موحّد لجميع أنواع الدعم) — كل سجل هو عملية صرف فعلية لمستفيد واحد من دفعة وارد
model Support {
  id            String        @id @default(cuid())
  beneficiaryId String
  beneficiary   Beneficiary   @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)
  category      String // IN_KIND | CASH | HOUSING | ECONOMIC | HEALTH | EDUCATIONAL | SERVICES
  amount        Float? // القيمة النقدية أو التقديرية (إن وُجدت)
  description   String? // وصف الصنف (للدعم العيني بشكل أساسي)
  quantity      Int? // الكمية (للدعم العيني)
  supportDate   DateTime
  year          Int // السنة المالية للدعم
  status        String        @default("DISBURSED") // PENDING | DISBURSED | CANCELLED
  notes         String?
  batchId       String?
  batch         SupportBatch? @relation(fields: [batchId], references: [id])
  createdAt     DateTime      @default(now())
  createdById   String?
  createdBy     User?         @relation("SupportCreatedBy", fields: [createdById], references: [id])
  surveySentAt  DateTime? // تاريخ إرسال رسالة استبيان قياس الرضا لهذا الصرف (فارغ = لم تُرسل بعد)

  @@index([beneficiaryId])
  @@index([year])
  @@index([category])
}

// دفعة دعم واردة (نموذج المستودع: استلام أولاً، ثم توزيع لاحق من نفس الرصيد على جلسة أو أكثر)
model SupportBatch {
  id                 String   @id @default(cuid())
  title              String // اسم الدفعة (يُولَّد تلقائياً من النوع والتاريخ إن لم يُدخَل)
  category           String // نفس تصنيفات الدعم أعلاه
  totalAmount        Float // إجمالي القيمة الواردة = مبلغ مباشر أو (quantity × unitPrice) للعيني
  quantity           Int? // عدد الوحدات الواردة (للعيني، اختياري للتوثيق)
  unitPrice          Float? // سعر الوحدة (للعيني، اختياري للتوثيق)
  receivedDate       DateTime
  year               Int
  status             String   @default("OPEN") // OPEN | CLOSED (إغلاق يدوي فقط)
  distributionMethod String   @default("HEAD_PLUS_DEPENDENTS") // UNIFIED | HEAD_PLUS_DEPENDENTS
  unifiedAmount      Float? // المبلغ/القيمة الموحّدة لكامل الأسرة (طريقة UNIFIED)
  headAmount         Float? // مبلغ رب الأسرة (طريقة HEAD_PLUS_DEPENDENTS)
  dependentAmount    Float? // مبلغ كل تابع (طريقة HEAD_PLUS_DEPENDENTS)
  notes              String?
  createdAt          DateTime @default(now())
  createdById        String?
  createdBy          User?    @relation("BatchCreatedBy", fields: [createdById], references: [id])

  supports Support[]
}

// الدورات التدريبية
model Course {
  id          String    @id @default(cuid())
  title       String
  category    String // COMPUTER | LANGUAGES | AI | LIFE_SKILLS | OTHER
  trainer     String?
  startDate   DateTime
  endDate     DateTime?
  seatsCount  Int?
  location    String?
  totalCost   Float? // التكلفة الإجمالية للدورة، تُضاف كرقم واحد لإجمالي الدعوم العام
  notes       String?
  createdAt   DateTime  @default(now())
  createdById String?
  createdBy   User?     @relation("CourseCreatedBy", fields: [createdById], references: [id])

  participants CourseParticipant[]

  @@index([category])
}

// مشاركو الدورات التدريبية — بيان مستقل تماماً عن جدول المستفيدين (قد يكونوا أبناءهم أو غيرهم)،
// مع إمكانية ربط اختياري بمستفيد مسجَّل لأغراض الإحالة فقط
model CourseParticipant {
  id                String       @id @default(cuid())
  courseId          String
  course            Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  fullName          String
  civilId           String? // رقم السجل المدني / الهوية
  phone             String?
  birthDate         DateTime?
  birthDateHijri    String?
  email             String?
  beneficiaryId     String? // ربط اختياري بمستفيد مسجَّل (للإحالة فقط، ليس شرطاً)
  beneficiary       Beneficiary? @relation(fields: [beneficiaryId], references: [id], onDelete: SetNull)
  status            String       @default("ENROLLED") // ENROLLED | COMPLETED | DROPPED
  certificateIssued Boolean      @default(false)
  notes             String?
  createdAt         DateTime     @default(now())
  createdById       String?
  createdBy         User?        @relation("ParticipantCreatedBy", fields: [createdById], references: [id])

  @@index([courseId])
}

// إعدادات عامة للنظام - صف واحد فقط (id ثابت)، بدل جدول إعدادات عام (key/value) لأن عدد
// الإعدادات محدود ومعروف مسبقاً. تُستخدم لإعدادات إرسال رسائل استبيان قياس الرضا.
// النظام لا يرسل الرسائل النصية آلياً (منصة الرسائل حساب مشترك بين عدة جهات، ليس ملكاً
// خاصاً بالجمعية) — يُرسل الموظف يدوياً عبر بوابة المنصة، والنظام يجهّز الروابط فقط
model AppSettings {
  id                   String   @id @default("singleton")
  surveyFormBaseUrl    String? // رابط نموذج استبيان قياس الرضا (Google Forms أو غيره)
  surveyFormEntryParam String? // اسم حقل الرقم المرجعي في النموذج (مثل entry.1234567890)؛
  // إن تُرك فارغاً يُرسَل الرابط العام دون تخصيص لكل مستفيد
  updatedAt            DateTime @updatedAt
}
